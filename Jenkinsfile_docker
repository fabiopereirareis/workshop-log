
pipeline {
    agent { label 'docker-build' }

    tools {    
        gradle 'Gradle-8'
    }
    stages {
        stage('Build') { 
            steps {
                sh 'gradle clean build -x test' 
            }
        }
        stage('Salvar artefato') {
            steps {
                archiveArtifacts artifacts: 'build/libs/*.jar', fingerprint: true
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t minha-imagem .'
                }
            }
        }
    }
}
